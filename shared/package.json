{
  "name": "@mkg/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:gen": "tsx src/openapi/build.ts > dist/openapi.yaml"
  },
  "dependencies": {
    "zod": "3.23.8",
    "@asteasolutions/zod-to-openapi": "7.1.1",
    "yaml": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "tsx": "4.16.5",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
